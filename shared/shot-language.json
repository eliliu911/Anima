    {
      "id": "move",
      "name": "运镜",
      "stillNote": "运镜只进视频提示词 —— 静帧里没有「推」这回事",
      "items": [
        {
          "id": "static",
          "name": "固定",
          "prompt": {
            "en": "static camera, locked off",
            "zh": "镜头固定不动，由表演和环境完成叙事"
          },
          "still": false,
          "note": "**「固定」是严格的：零移动、零变焦、零对焦变化。** 只要有任何一样，就不要写固定，去挑对应的那一条 —— 写了固定又出现运动动词，模型要么忽略其一，要么出自相矛盾的抖动。",
          "group": "still"
        },
        {
          "id": "push_in",
          "name": "推镜头",
          "prompt": {
            "en": "slow push in, dolly in",
