  "chineseEngines": {
    "note": "编码器中文原生的引擎 —— 这些引擎发中文提示词，其余发英文。别名要写全：项目里存的可能是 minimax_h3 / ltx25 这些老写法，漏一条的表现是那个引擎静默收到英文，图照出、只是那一段基本不生效。",
    "ids": [
      "zimage",
      "z_image",
      "h3",
      "minimax_h3",
      "minimax-h3",
      "ltx",
      "ltx25",
      "ltx2.5",
      "ltx-2.5",
      "krea2",
      "krea-2",
      "krea_2",
      "krea",
      "qwen21",
      "qwen-2.1",
      "qwen_2_1",
      "qwen_image_2.1",
      "qwen-image-2.1"
    ]
  },
  "groups": [
    {
      "id": "shotSize",
      "name": "景别",
      "aspectAware": true,
      "items": [
        {
          "id": "extreme_wide",
          "name": "大远景",
          "prompt": {
            "en": "extreme long shot, establishing shot",
            "zh": "大远景，交代环境全貌"
          },
          "still": true,
          "aspect": "landscape",
          "note": "横幅。人只占一小块，脸的像素预算约等于零 —— 别在这一档指望长相"
        },
        {
          "id": "wide",
          "name": "远景",
          "prompt": {
            "en": "long shot, wide shot",
            "zh": "远景，人物完整入画且环境占主导"
          },
          "still": true,
          "aspect": "landscape"
        },
        {
          "id": "full_body",
          "name": "全景",
          "prompt": {
            "en": "full body shot, head to toe",
            "zh": "全身入画，从头到脚完整可见"
          },
          "still": true,
          "aspect": "portrait",
          "aspectHard": true,
          "note": "**一定用竖画幅。** 1:1 下人物被横向压缩，脸和手的像素预算都不够 —— 这是手指畸形最常见的间接原因（实测）"
        },
        {
          "id": "medium",
          "name": "中景",
          "prompt": {
            "en": "medium shot, waist up",
            "zh": "中景，腰部以上"
          },
          "still": true,
          "aspect": "portrait",
          "note": "竖或方都行"
        },
        {
          "id": "medium_close",
          "name": "近景",
          "prompt": {
            "en": "close-up, head and shoulders",
            "zh": "近景，头和肩"
          },
          "still": true,
          "aspect": "square"
        },
        {
          "id": "close_up",
          "name": "特写",
          "prompt": {
            "en": "close-up, face fills the frame",
            "zh": "特写，脸部充满画面"
          },
          "still": true,
          "aspect": "square",
          "note": "脸的像素预算最足，锁身份用这一档"
        },
        {
          "id": "extreme_close_up",
          "name": "大特写",
          "prompt": {
            "en": "extreme close-up, macro detail",
            "zh": "大特写，眼睛或局部细节充满画面"
          },
          "still": true,
          "aspect": "square"
        }
      ],
      "aspectNote": "aspect 是**建议**，给单张出图用（那时候画幅是你自己挑的）。剧集的画幅由项目定死，混画幅会毁剪辑 —— 所以那边只在 aspectHard 的档位上提示。aspectHard = 画幅不对会**实际出问题**，不是不够理想。加这个标记前先问一句：有实测吗？没有就别加，报太多等于没报。"
    },
