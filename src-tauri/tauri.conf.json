{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anima",
  "version": "0.43.42",
  "identifier": "com.anima.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "avatar",
        "title": "Anima",
        "width": 730,
        "height": 608,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": true,
        "focus": false,
        "url": "index.html?window=avatar",
        "minWidth": 420,
        "minHeight": 380
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPCACHE/**",
          "$HOME/**",
          "**"
        ]
      },
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: anima-media: data: blob: http://127.0.0.1:* http://localhost:*",
        "media-src": "'self' asset: anima-media: data: blob: http://127.0.0.1:* http://localhost:*",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
