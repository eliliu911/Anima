{
  "name": "anima",
  "private": true,
  "version": "0.43.42",
  "type": "module",
  "description": "AI 语音数字人助手 —— 桌面客户端",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "gen:icon": "node scripts/gen-icon.mjs",
    "tauri:dev": "scripts/with-env.sh tauri dev",
    "tauri:build": "scripts/with-env.sh tauri build",
    "test:live": "scripts/with-env.sh sh -c 'cd src-tauri && cargo test --test live -- --ignored --nocapture --test-threads=1'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mkkellogg/gaussian-splats-3d": "0.4.6",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.6",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xyflow/react": "^12.11.6",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.44.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^7.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.2.7",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.3",
    "vite": "^6.0.11",
    "vitest": "^4.1.10"
  }
}
